{
  "debugLevel": 9,
  "applications": [
    {
      "id": "Fixed",
      "executable": "RegLegacyTest.exe",
      "workingDirectory": ""
    }
  ],
  "processes": [
    {
      "executable": "PsfLauncher.*"
    },
    {
      "executable": "^[Pp]ower[Ss]hell.*"
    },
    {
      "executable": "^[Cc][Mm][Dd].*"
    },
    {
      "executable": ".*",
      "fixups": [
        {
          "dll": "RegLegacyFixups.dll",
          "config": [
            {
              "remediation": [
                {
                  "type": "ModifyKeyAccess",
                  "hive": "HKCU",
                  "patterns": [
                    "^Software\\\\Vendor_Covered.*"
                  ],
                  "access": "Full2MaxAllowed"
                },
                {
                  "type": "ModifyKeyAccess",
                  "hive": "HKLM",
                  "patterns": [
                    "^SOFTWARE\\\\Vendor_Covered.*",
                    "^SOFTWARE\\\\Wow3264Node\\\\Vendor_Covered.*"
                  ],
                  "access": "RW2MaxAllowed"
                },
                {
                  "type": "FakeDelete",
                  "hive": "HKCU",
                  "patterns": [
                    "^SOFTWARE\\\\Vendor_Covered.*"
                  ]
                },
                {
                  "type": "JavaBlocker",
                  "majorVersion": "1",
                  "minorVersion": "7",
                  "updateVersion": "1"
                },
                {
                  "type": "DeletionMarker",
                  "hive": "HKCU",
                  "key": "[Ss][Oo][Ff][Tt][Ww][Aa][Rr][Ee]\\\\Vendor_Deletion\\\\SubKey.*",
                  "patterns": [
                    "SubKey.*",
                    "HideThis.*"
                  ]
                },
                {
                  "type": "HKLM2HKCU",
                  "hive": "HKLM"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}